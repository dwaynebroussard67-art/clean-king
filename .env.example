# Use a dedicated, owner-approved Supabase project. Never commit actual keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Exact canonical origin, no trailing slash. HTTPS is required in production.
APP_ORIGIN=
# Cloudflare Turnstile keys; configure the exact hostname and actions application / quote.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# These flags enable only controlled development/test environments. They do nothing in production.
# A separate, explicit HTTPS owner demo gate is documented below. Never use real personal data.
INTAKE_ENABLED=false
OWNER_EMAIL_LINK_ENABLED=false

# Application-to-owner email: intentionally disabled until delivery and privacy are approved.
APPLICATION_EMAIL_NOTIFICATIONS_ENABLED=false
# PLACEHOLDER: enter the owner's verified email later; never put applicant data here.
APPLICATION_NOTIFICATION_TO=
# A single sender address at a domain verified with the email provider.
APPLICATION_NOTIFICATION_FROM=
# Server-only Resend API key, never NEXT_PUBLIC_.
RESEND_API_KEY=
# Random server-only scheduler secret (at least 32 characters); required by the job endpoint.
CRON_SECRET=

# Owner assistant endpoints: dedicated synthetic workspace only. Settings also default to off.
OWNER_ASSISTANT_ENABLED=false
# Server only. Generate once with: openssl rand -base64 32
# Keep stable and backed up securely; changing this key makes saved provider keys unreadable.
ASSISTANT_SECRET_KEY=
# Optional server-only fallback if no Anthropic key is saved in the panel. Custom has no env fallback.
ANTHROPIC_API_KEY=
# Development only; never enables a local custom provider in production. Prefer public HTTPS.
AI_ALLOW_LOCAL_CUSTOM=false
# Explicit HTTPS owner demo login ONLY. Does not enable intake, referrals or application email.
DEMO_MODE=false
# Leave blank by default. Required exact acknowledgment for a synthetic demo: I_UNDERSTAND_SYNTHETIC_DATA_ONLY
DEMO_MODE_ACK=

# Experimental referral prototype; hard-disabled in production builds until secure employee authentication exists.
REFERRALS_ENABLED=false
