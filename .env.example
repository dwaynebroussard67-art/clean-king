# Use a dedicated, owner-approved Supabase project. Never commit actual keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Exact canonical origin, no trailing slash. HTTPS is required in production.
APP_ORIGIN=
# Cloudflare Turnstile keys; configure the exact hostname and actions application / quote.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Both default off. Intake and owner email-link login are hard-disabled in production builds, even if true.
# These flags only enable controlled development/test environments; do not use real personal data.
INTAKE_ENABLED=false
OWNER_EMAIL_LINK_ENABLED=false

# Application-to-owner email: intentionally disabled until delivery and privacy are approved.
APPLICATION_EMAIL_NOTIFICATIONS_ENABLED=false
# PLACEHOLDER: enter the owner's verified email later; never put applicant data here.
APPLICATION_NOTIFICATION_TO=
# A single sender address at a domain verified with the email provider.
APPLICATION_NOTIFICATION_FROM=
# Server-only Resend API key, never NEXT_PUBLIC_.
RESEND_API_KEY=
# Random server-only scheduler secret (at least 32 characters); required by the job endpoint.
CRON_SECRET=

# Owner assistant is an experimental, read-only development feature. Keep off until security review.
OWNER_ASSISTANT_ENABLED=false
# Server only. Supply an approved current Anthropic model ID; no built-in model or fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional OpenAI-compatible slot. Only deployment operators set these; no secrets or URLs in owner UI.
# HTTPS URL, exact trusted hostname on the allowlist; redirects and IP literals are rejected.
ASSISTANT_OPEN_BASE_URL=
ASSISTANT_OPEN_ALLOWED_HOSTS=
ASSISTANT_OPEN_API_KEY=
ASSISTANT_OPEN_MODEL=

# Experimental referral prototype; hard-disabled in production builds until secure employee authentication exists.
REFERRALS_ENABLED=false
